# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fet_platform"
# Long random string used to sign JWTs
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Google OAuth Client ID (Web application) from https://console.cloud.google.com
# Enables the "Sign in with Google" button. Leave empty to disable it.
GOOGLE_CLIENT_ID=""
# Any user registering with this email becomes an ADMIN
ADMIN_EMAIL=""
